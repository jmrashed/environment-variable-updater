{
  "version": "2.0.0",
  "preserve_comments": true,
  "verbose": false,
  "backup_retention_days": 30,
  "default_environments": ["local", "server", "staging", "production"],
  "encryption": {
    "enabled": false,
    "sensitive_keys": ["PASSWORD", "SECRET", "KEY", "TOKEN", "API_KEY"],
    "algorithm": "AES256"
  },
  "validation": {
    "strict_mode": true,
    "allow_empty_values": false,
    "required_keys": []
  },
  "backup": {
    "auto_backup": true,
    "max_backups": 10,
    "backup_location": "./backups"
  },
  "logging": {
    "level": "INFO",
    "file": "./update-env.log",
    "max_size_mb": 10,
    "rotate": true
  },
  "formats": {
    "supported": ["env", "json", "yaml"],
    "default": "env"
  },
  "security": {
    "sanitize_input": true,
    "prevent_injection": true,
    "audit_changes": true
  }
}